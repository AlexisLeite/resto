[Unit]
Description=Resto por Tailscale
Wants=network-online.target tailscaled.service postgresql.service
After=network-online.target tailscaled.service postgresql.service
StartLimitIntervalSec=0

[Service]
Type=simple
User=resto-web
Group=resto-web
WorkingDirectory=/repos/resto
EnvironmentFile=/repos/resto/.env
Environment=NODE_ENV=production
Environment=NEXT_TELEMETRY_DISABLED=1
ExecStart=/usr/local/bin/node /repos/resto/node_modules/next/dist/bin/next start --hostname 127.0.0.1 --port 27778
SuccessExitStatus=143
Restart=always
RestartSec=5
TimeoutStopSec=30
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/repos/resto/.next

[Install]
WantedBy=multi-user.target
